# ── Server ──────────────────────────────────────────────
PORT=5000
# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_ORIGIN=http://localhost:5173

# ── Supabase ────────────────────────────────────────────
# Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The SERVICE ROLE key (Project Settings -> API -> service_role).
# NEVER put this in the frontend. Backend-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI Provider (Anthropic Claude) ─────────────────────
# Optional at startup: if missing, the server still starts and
# document analysis returns a clear "AI unavailable" fallback
# instead of crashing.
ANTHROPIC_API_KEY=your-anthropic-api-key

# ---------------------------------------------------------------------------
# FamilyVault AI - environment configuration
# Copy to `.env` and fill in. Every value below has a working default except
# AUTH_SECRET and DOCUMENT_ENCRYPTION_KEY, which are required in production.
#
# Privacy first: this file holds the only secrets protecting the vault. Keep
# `.env` readable only by you (chmod 600), never commit it, and back up
# DOCUMENT_ENCRYPTION_KEY separately — without it the documents cannot be read.
# ---------------------------------------------------------------------------

# --- Deployment ------------------------------------------------------------
# Public hostname the reverse proxy (Caddy) serves, e.g. vault.example.com.
# Leave as "localhost" to test locally with a self-signed certificate.
SITE_ADDRESS="localhost"

# --- Database --------------------------------------------------------------
# SQLite (default). Path is relative to the project root.
DATABASE_URL="file:./dev.db"
# For PostgreSQL instead, change `provider` in prisma/schema.prisma to
# "postgresql" and use:
# DATABASE_URL="postgresql://user:password@host:5432/familyvault?schema=public"

# --- Authentication (REQUIRED) ---------------------------------------------
# Secret used to sign session JWTs. Generate one with:
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Session lifetime, e.g. "7d", "24h", "30m".
AUTH_SESSION_MAX_AGE="7d"

# Set to "true" when serving over HTTPS (behind the Caddy proxy). Adds the
# `Secure` cookie flag so session cookies are never sent over plain HTTP.
AUTH_TRUST_HTTPS="true"

# --- Document encryption at rest (REQUIRED for real use) -------------------
# Files are stored AES-256-GCM encrypted. This passphrase is stretched into a
# 32-byte key with scrypt. Generate one with:
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Back this up offline and do NOT rotate it while documents exist: changing it
# makes every already-stored file undecryptable.
DOCUMENT_ENCRYPTION_KEY=""

# Where encrypted files live. MUST be outside ./public so files are never
# served statically. Relative paths resolve from the project root.
STORAGE_DIR="./storage"

# --- Upload limits ---------------------------------------------------------
MAX_UPLOAD_MB="15"

# OCR engine: replace the placeholder before using this environment file.
# Valid options, written here in uppercase: TESSERACT (local OCR), NONE (disabled).
# Enter the chosen option in lowercase. Omitting OCR_ENGINE uses the local engine.
OCR_ENGINE=<choose-lowercase-engine>
# Comma-separated ISO 639-3 language codes.
OCR_LANGUAGES="eng"
# Optional directory containing locally downloaded OCR language data.
OCR_LANG_PATH="./storage/ocr-lang"
# Characters of text above which a PDF is considered to have a usable text
# layer and is not sent through OCR.
PDF_TEXT_LAYER_MIN_CHARS="40"
# A PDF that is only pictures (a scan) is read by first turning its pages into
# images, which needs a renderer on the host:
#   apt-get install poppler-utils      (the Dockerfile already does this)
# Without it, scanned PDFs are still stored and downloadable; the app just says
# plainly that the pages could not be read.
# How many pages get read per upload is fixed in code (src/lib/constants.ts),
# not configurable here, because one OCR worker handles every upload.

# --- Assistant -------------------------------------------------------------
# Documents retrieved as local context for each assistant answer. The answer is
# always composed on this machine; there is no AI provider and no network egress.
ASSISTANT_MAX_CONTEXT_DOCS="6"

# --- Expiry reminders ------------------------------------------------------
# Documents expiring within this many days are shown as "upcoming".
EXPIRY_WARNING_DAYS="60"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="FamilyVault AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
